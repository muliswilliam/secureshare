# Database (self-hosted Postgres). Point both at the same connection string
# unless a pooler like PgBouncer is introduced in front of Postgres.
POSTGRES_PRISMA_URL=postgres://secureshare:secureshare@localhost:5432/secureshare
POSTGRES_URL_NON_POOLING=postgres://secureshare:secureshare@localhost:5432/secureshare

# Auth (Better Auth)
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Storage (Cloudflare R2 in production; MinIO's compose service works as a local
# S3-compatible stand-in for development, since both speak the S3 API)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET_NAME=secureshare
STORAGE_PUBLIC_URL=http://localhost:9000/secureshare

# Redis (BullMQ expiry-sweep job queue)
REDIS_URL=redis://localhost:6379
# Cron pattern for the recurring expiry sweep. Defaults to every 5 minutes.
EXPIRE_MESSAGES_SWEEP_CRON=*/5 * * * *

# LiveKit (unchanged by this migration)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Resend (unchanged by this migration)
RESEND_API_KEY=
